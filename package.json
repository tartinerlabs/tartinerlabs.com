{
  "name": "tartinerlabs.com",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "portless tartinerlabs next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@heroui/react": "3.0.0-beta.3",
    "@heroui/styles": "3.0.0-beta.3",
    "@posthog/next": "0.9.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "motion": "12.40.0",
    "next": "16.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "portless": "0.15.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.8.2",
      "onFail": "download"
    }
  }
}
